{
	"name": "@tinyedge/pi-runtime",
	"version": "0.84.2-tinyedge.1",
	"description": "Audited TinyEdge compatibility package for the Pi SDK and runtime",
	"type": "module",
	"piConfig": {
		"configDir": ".pi"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./rpc-entry": {
			"import": "./dist/rpc-entry.js"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"import": "./dist/client/index.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"CHANGELOG.md",
		"LICENSE",
		"NOTICE",
		"SBOM.cdx.json",
		"THIRD_PARTY_NOTICES.md",
		"UPSTREAM.md",
		"UPSTREAM_README.md",
		"scripts/verify-package.mjs",
		"npm-shrinkwrap.json"
	],
	"scripts": {
		"verify": "node ./scripts/verify-package.mjs",
		"test": "npm run verify",
		"prepack": "npm run verify"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "0.84.2",
		"@earendil-works/pi-ai": "0.84.2",
		"@earendil-works/pi-client": "0.84.2",
		"@earendil-works/pi-protocol": "0.84.2",
		"@earendil-works/pi-tui": "0.84.2",
		"chalk": "5.6.2",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"glob": "13.0.6",
		"grok-mermaid": "0.2.2",
		"highlight.js": "10.7.3",
		"hosted-git-info": "9.0.3",
		"ignore": "7.0.5",
		"jiti": "2.7.0",
		"minimatch": "10.2.5",
		"proper-lockfile": "4.1.2",
		"semver": "7.8.0",
		"typebox": "1.3.7",
		"undici": "8.9.0",
		"yaml": "2.9.0"
	},
	"overrides": {
		"protobufjs": "7.6.5",
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	},
	"peerDependencies": {
		"@mariozechner/clipboard": "0.3.9",
		"@silvia-odwyer/photon-node": "0.3.4"
	},
	"peerDependenciesMeta": {
		"@mariozechner/clipboard": {
			"optional": true
		},
		"@silvia-odwyer/photon-node": {
			"optional": true
		}
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"tui",
		"agent"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PhysicalSystems/tinyedge-edge.git",
		"directory": "packages/pi-runtime"
	},
	"homepage": "https://github.com/PhysicalSystems/tinyedge-edge/tree/main/packages/pi-runtime#readme",
	"bugs": {
		"url": "https://github.com/PhysicalSystems/tinyedge-edge/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
